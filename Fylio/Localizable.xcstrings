    "onboarding.welcome.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send any file to any device, wirelessly and securely."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将任何文件无线、安全地发送到任何设备。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी फ़ाइल को किसी भी डिवाइस पर वायरलेस और सुरक्षित रूप से भेजें।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía cualquier archivo a cualquier dispositivo, de forma inalámbrica y segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez n'importe quel fichier vers n'importe quel appareil, sans fil et en toute sécurité."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل أي ملف إلى أي جهاز، لاسلكياً وبأمان."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie qualquer ficheiro para qualquer dispositivo, sem fios e de forma segura."
          }
        }
      }
    },
