        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके द्वारा कनेक्ट किए गए डिवाइस यहाँ सहेजे जाएँगे"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dispositivos a los que te conectes se guardarán aquí"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appareils auxquels vous vous connectez seront enregistrés ici"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حفظ الأجهزة التي تتصل بها هنا"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dispositivos a que ligar serão guardados aqui"
          }
        }
      }
    },
