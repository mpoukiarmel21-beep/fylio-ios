    "devices.empty.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices you connect to will be saved here"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您连接的设备将保存在这里"
          }
